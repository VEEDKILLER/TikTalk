# OpenAI - required for Diffusion (DALL-E 3), VLM (GPT-4V), and Evaluate
OPENAI_API_KEY=your_openai_api_key_here

# Alibaba DashScope - required for Qwen VLM branch
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Google Gemini - required for VLM judge
GEMINI_API_KEY=your_gemini_api_key_here

# ASR endpoint (default points to deployed Modal service)
ASR_ENDPOINT=https://howdybunny--tiktalk-asr-serve-app.modal.run/transcribe

# VLM model overrides (optional)
OPENAI_VLM_MODEL=gpt-4o
QWEN_VLM_MODEL=qwen-vl-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GEMINI_JUDGE_MODEL=gemini-1.5-flash

# Evaluate LLM model (optional, defaults to gpt-4o-mini for cost efficiency)
EVALUATE_MODEL=gpt-4o-mini
